+        items.append(f'        <li><strong>{esc(p["name"])}</strong>{link}{addr}{leg}</li>')
+    route_html = "\n".join(items)
+
+    notes = "\n      ".join(f"<p>{esc(n)}</p>" for n in ROUTE_NOTES.get(hood, []))
