+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <title>How to visit New York art galleries (when you've never done it before) | NYC Gallery Tracker</title>
+  <meta name="viewport" content="width=device-width, initial-scale=1">
